// Prisma schema：宿主侧的大屏文档表。
//
// 数据库文件在 ../data/screens.db——SQLite 的相对路径按 **schema 所在目录** 解析，
// 因此这里用 ../data 指回工程根目录下的 data/（该目录随仓库提交 .gitkeep 保留）。
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// document 存 canonical Screen Document JSON（由 @base-screen/contracts 拥有 schema），
/// 后端只做存取与 revision 乐观锁，不理解文档内部结构。
model Screen {
  id           String              @id @default(uuid())
  name         String
  document     String
  revision     Int                 @default(1)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  alarmBinding ScreenAlarmBinding?
}

/// 宿主侧告警绑定：key → 组件 id → 等级 → 样式覆盖。屏幕文档不保存告警知识，
/// 这张表就是宿主按屏持久化的那一份；值为 JSON，结构由 alarm-binding-guard 校验。
model ScreenAlarmBinding {
  screenId  String   @id
  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  config    String
  updatedAt DateTime @updatedAt
}

/// 宿主素材库（ADR-0089）：文件落在 data/assets/，这张表只存元数据与稳定 id。
/// Screen Document 只保存 resourceType + resourceId，不保存这里的任何 URL。
model Asset {
  id        String   @id @default(uuid())
  name      String
  mimeType  String
  /// 含点的扩展名，由服务端按 MIME 白名单决定，不接受客户端输入
  extension String
  byteSize  Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// 在线物料包（ADR-0090）：宿主生成并审核的 ESM 代码与 Manifest，只存储、不执行。
/// 同一 type 至多一条；代码更新使用新 tagName + 新 constructor（见 Manifest）。
model MaterialPackage {
  id        String   @id @default(uuid())
  /// 稳定物料 type：文档身份，创建后不可改
  type      String   @unique
  name      String
  /// 宿主导入的 ESM 模块源码（default export 是 Custom Element 构造器）
  code      String
  /// JSON 字符串：完整 Manifest，必须与代码里的 static manifest 一致
  manifest  String
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

/// 数据源台账（PRD §8.1）。内置 4 个数据集**不入表**：它们由
/// `src/datasets/dataset-definitions.ts` 的代码常量提供，落表会产生两份会漂移的真理。
model DataSource {
  id          String   @id @default(uuid())
  /// 对外的稳定标识：`custom.<slug>`，创建后不可改（大屏文档里存的就是它）
  datasetId   String   @unique
  name        String
  /// 空说明必须落 null：契约里 `description` 是 `string | null`，空串非法（text.min(1)）
  description String?
  /// sqlite | rest | static（builtin 不入表）
  type        String
  /// 版本化 JSON：`{"v":1, ...}`，三种形状见 `src/datasources/datasource.types.ts`
  config      String
  /// draft | ready | error
  status      String   @default("draft")
  /// JSON: `{at,ok,code?,message?,durationMs?,rowCount?,truncated?}`
  lastTest    String?
  /// JSON: `DatasetFieldDefinition[]`（最近一次成功取数的字段）
  /// 落库理由：`describe` 必须在不执行查询的前提下返回字段，且要与 `query` 逐字段一致——
  /// 落库后 `query` 用这份字段**投影**结果，一致性由构造保证而不是靠两次推断恰好相同。
  fields      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([status])
}
