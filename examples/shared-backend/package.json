{
  "name": "@base-screen-example/shared-backend",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Base Screen 全栈示例的共享后端：NestJS REST API + Prisma/SQLite，供 React / Vue / Vanilla 三个前端共同消费",
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && nest start --watch",
    "build": "prisma generate && nest build",
    "start": "prisma migrate deploy && node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && jest"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.0.0",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "5.9.3"
  }
