{
  "name": "@base-screen/host-kit",
  "version": "0.0.0",
  "description": "宿主接入辅助：项目适配器与数据集端口的 REST 实现，内置契约硬规矩与错误码映射",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/translateServers/base-screen.git",
    "directory": "packages/host-kit"
  },
  "homepage": "https://github.com/translateServers/base-screen#readme",
  "bugs": "https://github.com/translateServers/base-screen/issues",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@base-screen/contracts": "workspace:^"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{force:true,recursive:true})\"",
    "lint": "biome check src tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
