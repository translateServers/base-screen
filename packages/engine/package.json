{
  "name": "@base-screen/engine",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@base-screen/contracts": "workspace:^",
    "@base-screen/core": "workspace:^",
    "@base-screen/plugin-core": "workspace:^",
    "@base-screen/renderer": "workspace:^"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').rmSync('dist/common/vendor',{force:true,recursive:true})\" && vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{force:true,recursive:true})\"",
    "lint": "biome check src tests && node ../../scripts/check-designer-ui.mjs && node ../../scripts/check-designer-styles.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.vendor.json"
  }
}
