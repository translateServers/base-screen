{
  "name": "@base-screen/renderer",
  "version": "0.1.0",
  "description": "物料模型与 DOM 渲染，保持纯展示职责",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/nebula_78/base-screen.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@base-screen/contracts": "workspace:^",
    "@base-screen/core": "workspace:^",
    "@base-screen/plugin-core": "workspace:^"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{force:true,recursive:true})\"",
    "lint": "biome check src tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
