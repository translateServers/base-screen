{
  "name": "@base-screen/material",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/auto-register.js"
  ],
  "dependencies": {
    "@base-screen/contracts": "workspace:^",
    "@base-screen/plugin-core": "workspace:^",
    "@base-screen/plugin-sdk": "workspace:^"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto-register": {
      "types": "./dist/auto-register.d.ts",
      "import": "./dist/auto-register.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{force:true,recursive:true})\"",
    "lint": "biome check src tests",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
