{
  "name": "@base-screen/material",
  "version": "0.1.0",
  "description": "官方物料实现、Manifest 和注册辅助",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/translateServers/base-screen.git",
    "directory": "packages/material"
  },
  "homepage": "https://github.com/translateServers/base-screen#readme",
  "bugs": "https://github.com/translateServers/base-screen/issues",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/auto-register.js"
  ],
  "dependencies": {
    "@base-screen/contracts": "workspace:^",
    "@base-screen/plugin-core": "workspace:^",
    "@base-screen/plugin-sdk": "workspace:^"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto-register": {
      "types": "./dist/auto-register.d.ts",
      "import": "./dist/auto-register.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js"
    },
    "./container": {
      "types": "./dist/container.d.ts",
      "import": "./dist/container.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./rule": {
      "types": "./dist/rule.d.ts",
      "import": "./dist/rule.js"
    },
    "./shapes": {
      "types": "./dist/shapes.d.ts",
      "import": "./dist/shapes.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{force:true,recursive:true})\"",
    "lint": "biome check src tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
