{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "backgroundColor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "backgroundImage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "backgroundImageFit": {
          "type": "string",
          "enum": ["cover", "contain"]
        }
      },
      "required": ["width", "height", "backgroundColor"],
      "additionalProperties": false
    },
    "components": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "size": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000
              }
            },
            "required": ["width", "height"],
            "additionalProperties": false
          },
          "rotation": {
            "type": "number",
            "minimum": -180,
            "exclusiveMaximum": 180
          },
          "zIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "status": {
            "type": "object",
            "properties": {
              "locked": {
                "type": "boolean"
              },
              "hidden": {
                "type": "boolean"
              }
            },
            "required": ["locked", "hidden"],
            "additionalProperties": false
          },
          "props": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "style": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "dataSource": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "static"
                  },
                  "value": {}
                },
                "required": ["type", "value"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "host-resource"
                  },
                  "resourceType": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                  },
                  "resourceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "params": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "literal"
                            },
                            "value": {}
                          },
                          "required": ["kind", "value"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "variable"
                            },
                            "name": {
                              "type": "string",
                              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                            }
                          },
                          "required": ["kind", "name"],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "binding": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "fields": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "additionalProperties": {
                              "minItems": 1,
                              "maxItems": 256,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 256
                              }
                            }
                          }
                        },
                        "required": ["fields"],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["type", "resourceType", "resourceId", "params", "binding"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "type",
          "name",
          "parentId",
          "position",
          "size",
          "rotation",
          "zIndex",
          "status",
          "props",
          "style",
          "dataSource"
        ],
        "additionalProperties": false
      }
    },
    "variables": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "static"
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
              },
              "value": {}
            },
            "required": ["type", "name", "value"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "host"
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
              },
              "variableId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": ["type", "name", "variableId"],
            "additionalProperties": false
          }
        ]
      }
    },
    "blueprint": {
      "type": "object",
      "properties": {
        "rules": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "trigger": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "material-event"
                  },
                  "componentId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "eventName": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                  }
                },
                "required": ["type", "componentId", "eventName"],
                "additionalProperties": false
              },
              "requiredCapabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              },
              "condition": {
                "type": "object",
                "properties": {
                  "left": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "operator": {
                    "type": "string",
                    "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "exists"]
                  },
                  "right": {
                    "$ref": "#/$defs/__schema0"
                  }
                },
                "required": ["left", "operator"],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "operator": {
                          "const": "exists"
                        }
                      },
                      "required": ["operator"]
                    },
                    "then": {
                      "not": {
                        "required": ["right"]
                      }
                    },
                    "else": {
                      "required": ["right"]
                    }
                  }
                ]
              },
              "actions": {
                "maxItems": 128,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "set-variable"
                        },
                        "variableName": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                        },
                        "value": {
                          "$ref": "#/$defs/__schema0"
                        }
                      },
                      "required": ["type", "variableName", "value"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "emit-host-event"
                        },
                        "eventName": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                        },
                        "payload": {
                          "$ref": "#/$defs/__schema0"
                        }
                      },
                      "required": ["type", "eventName", "payload"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "host-action"
                        },
                        "actionId": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                        },
                        "payload": {
                          "$ref": "#/$defs/__schema0"
                        }
                      },
                      "required": ["type", "actionId", "payload"],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": ["id", "trigger", "actions"],
            "additionalProperties": false
          }
        }
      },
      "required": ["rules"],
      "additionalProperties": false
    }
  },
  "required": ["canvas", "components", "variables", "blueprint"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "literal"
            },
            "value": {}
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "event-payload"
            },
            "path": {
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z_][A-Za-z0-9_]{0,127}$"
              }
            }
          },
          "required": ["kind", "path"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "variable"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
            }
          },
          "required": ["kind", "name"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "array"
            },
            "items": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": ["kind", "items"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object"
            },
            "properties": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              },
              "maxProperties": 256
            }
          },
          "required": ["kind", "properties"],
          "additionalProperties": false
        }
      ]
    }
  },
  "$id": "urn:base-screen:schema:screen-document"
}
