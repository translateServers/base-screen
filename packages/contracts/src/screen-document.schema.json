{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "backgroundColor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["width", "height", "backgroundColor"],
      "additionalProperties": false
    },
    "components": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\/v[1-9][0-9]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "size": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000
              }
            },
            "required": ["width", "height"],
            "additionalProperties": false
          },
          "rotation": {
            "type": "number",
            "minimum": -180,
            "exclusiveMaximum": 180
          },
          "zIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "status": {
            "type": "object",
            "properties": {
              "locked": {
                "type": "boolean"
              },
              "hidden": {
                "type": "boolean"
              }
            },
            "required": ["locked", "hidden"],
            "additionalProperties": false
          },
          "props": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "style": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "dataSource": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "static"
                  },
                  "value": {}
                },
                "required": ["type", "value"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "host-resource"
                  },
                  "resourceType": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                  },
                  "resourceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "params": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": ["type", "resourceType", "resourceId", "params"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "type",
          "name",
          "parentId",
          "position",
          "size",
          "rotation",
          "zIndex",
          "status",
          "props",
          "style",
          "dataSource"
        ],
        "additionalProperties": false
      }
    },
    "variables": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "static"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "value": {}
        },
        "required": ["type", "name", "value"],
        "additionalProperties": false
      }
    },
    "blueprint": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "number",
          "const": 1
        },
        "rules": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "trigger": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "material-event"
                  },
                  "componentId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "eventName": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                  }
                },
                "required": ["type", "componentId", "eventName"],
                "additionalProperties": false
              },
              "actions": {
                "maxItems": 128,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "set-variable"
                        },
                        "variableName": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                        },
                        "value": {}
                      },
                      "required": ["type", "variableName", "value"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "emit-host-event"
                        },
                        "eventName": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                        },
                        "payload": {}
                      },
                      "required": ["type", "eventName", "payload"],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": ["id", "trigger", "actions"],
            "additionalProperties": false
          }
        }
      },
      "required": ["apiVersion", "rules"],
      "additionalProperties": false
    }
  },
  "required": ["canvas", "components", "variables", "blueprint"],
  "additionalProperties": false,
  "$id": "urn:base-screen:schema:screen-document"
}
