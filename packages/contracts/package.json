{
  "name": "@base-screen/contracts",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "zod": "4.4.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./screen-document.schema.json": {
      "import": "./dist/screen-document.schema.json",
      "default": "./dist/screen-document.schema.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/write-schema-artifact.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{force:true,recursive:true})\"",
    "lint": "biome check src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
