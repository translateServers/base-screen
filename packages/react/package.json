{
  "name": "@base-screen/react",
  "version": "0.1.0",
  "description": "将 React 组件桥接为 Base Screen 物料",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/translateServers/base-screen.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/translateServers/base-screen#readme",
  "bugs": "https://github.com/translateServers/base-screen/issues",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@base-screen/contracts": "workspace:^",
    "@base-screen/plugin-core": "workspace:^",
    "@base-screen/plugin-sdk": "workspace:^",
    "@base-screen/sdk": "workspace:^"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{force:true,recursive:true})\"",
    "lint": "biome check src tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
