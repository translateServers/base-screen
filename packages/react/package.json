{
  "name": "@base-screen/react",
  "version": "0.0.0",
  "description": "将 React 组件桥接为 Base Screen 物料",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/nebula_78/base-screen.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@base-screen/contracts": "workspace:^",
    "@base-screen/plugin-core": "workspace:^",
    "@base-screen/plugin-sdk": "workspace:^"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{force:true,recursive:true})\"",
    "lint": "biome check src tests",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
