{
  "name": "@base-screen/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Viewer、Designer、物料与插件的产品级组合入口",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/translateServers/base-screen.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/translateServers/base-screen#readme",
  "bugs": "https://github.com/translateServers/base-screen/issues",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/auto-register.js",
    "./dist/designer-auto-register.js",
    "./dist/viewer-auto-register.js",
    "./dist/host-tokens.css"
  ],
  "dependencies": {
    "@base-screen/contracts": "workspace:^",
    "@base-screen/core": "workspace:^",
    "@base-screen/engine": "workspace:^",
    "@base-screen/material": "workspace:^",
    "@base-screen/plugin-core": "workspace:^",
    "@base-screen/plugin-manager": "workspace:^",
    "@base-screen/plugin-sdk": "workspace:^",
    "@base-screen/renderer": "workspace:^"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto-register": {
      "types": "./dist/auto-register.d.ts",
      "import": "./dist/auto-register.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.js"
    },
    "./viewer/auto-register": {
      "types": "./dist/viewer-auto-register.d.ts",
      "import": "./dist/viewer-auto-register.js"
    },
    "./designer": {
      "types": "./dist/designer.d.ts",
      "import": "./dist/designer.js"
    },
    "./designer/auto-register": {
      "types": "./dist/designer-auto-register.d.ts",
      "import": "./dist/designer-auto-register.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./plugin-core": {
      "types": "./dist/plugin-core.d.ts",
      "import": "./dist/plugin-core.js"
    },
    "./material": {
      "types": "./dist/material.d.ts",
      "import": "./dist/material.js"
    },
    "./host-tokens.css": "./dist/host-tokens.css"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && vite build && node -e \"const fs=require('node:fs');fs.copyFileSync(require.resolve('@base-screen/engine/host-tokens.css'),'dist/host-tokens.css')\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{force:true,recursive:true})\"",
    "lint": "biome check src tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
