{
  "name": "base-screen-monorepo",
  "version": "0.0.0",
  "description": "轻量、可嵌入、跨框架的大屏设计器基座：统一文档、画布设计、独立 Viewer 与物料扩展",
  "keywords": [
    "big-screen",
    "dashboard-designer",
    "web-components",
    "visualization",
    "embeddable",
    "designer"
  ],
  "author": "zhouan190",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/nebula_78/base-screen.git"
  },
  "homepage": "https://gitee.com/nebula_78/base-screen#readme",
  "bugs": "https://gitee.com/nebula_78/base-screen/issues",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "integration": "node .agents/skills/base-screen-integration-workflow/scripts/workflow.mjs",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "turbo run lint && pnpm check:boundaries && pnpm check:material-atomicity",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run",
    "test:scope": "node tooling/testing/test-scope.mjs",
    "test:audit": "node tooling/testing/test-audit.mjs",
    "test:baseline": "node tooling/testing/test-baseline.mjs",
    "test:tag": "node tooling/testing/tag-tests.mjs",
    "build": "pnpm sync:license && turbo run build",
    "clean": "turbo run clean && node tooling/clean.mjs",
    "dev:browser-harness": "vite tooling/verification/browser-harness",
    "dev:shared-backend": "pnpm --filter @base-screen-example/shared-backend dev",
    "dev:react-host": "pnpm --filter @base-screen-example/react-host dev",
    "dev:vue-host": "pnpm --filter @base-screen-example/vue-host dev",
    "dev:vanilla-host": "pnpm --filter @base-screen-example/vanilla-host dev",
    "sync:examples": "node tooling/verification/sync-examples.mjs",
    "verify:examples": "pnpm --filter @base-screen-example/vanilla-host verify && pnpm --filter @base-screen-example/react-host verify && pnpm --filter @base-screen-example/vue-host verify",
    "check:packages": "node tooling/checks/packages.mjs",
    "check:boundaries": "node tooling/checks/boundaries.mjs",
    "check:material-atomicity": "node tooling/checks/material-atomicity.mjs",
    "check:api": "node tooling/checks/api.mjs",
    "check:api-changesets": "node tooling/checks/api-changesets.mjs",
    "api:report": "pnpm build && node tooling/build/api-reports.mjs --update",
    "check:engine-import": "node tooling/checks/engine-import.mjs",
    "sync:license": "node tooling/build/sync-package-license.mjs",
    "verify:tarball": "node tooling/verification/verify-tarballs.mjs",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:packages && pnpm check:api && pnpm check:engine-import",
    "verify:browser": "node tooling/verification/verify-browser-harness.mjs",
    "verify:system": "node tooling/verification/browser-harness/system/run-system-assert.mjs",
    "verify:material-mcp": "node tooling/material-mcp-server/smoke.mjs",
    "pack:host-skill-kit": "node tooling/pack-host-skill-kit.mjs",
    "verify:nebula-import": "node tooling/verification/verify-nebula-import.mjs",
    "verify:m0": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:packages && pnpm check:api && pnpm check:engine-import && pnpm verify:tarball",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.6",
    "@changesets/cli": "2.31.1",
    "@microsoft/api-extractor": "7.58.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "echarts": "6.1.0",
    "publint": "0.3.22",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "turbo": "2.10.8",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue": "3.5.0",
    "vue-echarts": "8.1.0",
    "zod": "4.4.3"
  }
}
