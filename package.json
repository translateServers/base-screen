{
  "name": "base-screen-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "turbo run lint && pnpm check:boundaries",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run",
    "build": "pnpm sync:license && turbo run build",
    "clean": "turbo run clean && node scripts/clean.mjs",
    "dev:browser-harness": "vite examples/browser-harness",
    "dev:playground": "vite examples/playground",
    "dev:vue-harness": "vite examples/vue-harness",
    "check:packages": "node scripts/check-packages.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check:engine-import": "node scripts/check-engine-import.mjs",
    "sync:license": "node scripts/sync-package-license.mjs",
    "verify:tarball": "node scripts/verify-tarballs.mjs",
    "verify:browser": "node scripts/verify-browser-harness.mjs",
    "verify:playground": "node scripts/verify-playground.mjs",
    "verify:vue-harness": "node scripts/verify-vue-harness.mjs",
    "verify:runtime": "node scripts/verify-runtime-harness.mjs",
    "verify:nebula-import": "node scripts/verify-nebula-import.mjs",
    "verify:m0": "pnpm format && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:packages && pnpm check:api && pnpm check:engine-import && pnpm verify:tarball",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.6",
    "@changesets/cli": "2.31.1",
    "@microsoft/api-extractor": "7.58.12",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "echarts": "6.1.0",
    "publint": "0.3.22",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "turbo": "2.10.8",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue": "3.5.0",
    "vue-echarts": "8.1.0"
  }
}
